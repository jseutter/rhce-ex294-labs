# --- Ansible Temporary Files ---
*.retry
*.log
.ansible/
.ansible_cache/
.ansible_check_mode/

# --- Sensitive Information ---
# Always ignore vault password files if you store them locally
.vault_pass
*.vault_pass.txt

# --- Python Environment ---
__pycache__/
*.pyc
*.pyo
.venv/
env/
venv/
.tox/

# --- Collections and Roles ---
# If you use 'ansible-galaxy install', it's better to track the 
# requirements.yml file rather than the downloaded code itself.
ansible_collections/
roles/external/
# (Optional: Only ignore roles if you download them from Galaxy)
# roles/*
# !roles/my_custom_role/

# --- OS Specific ---
.DS_Store
.idea/
.vscode/

